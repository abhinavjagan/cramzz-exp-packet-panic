# The hub sets this when it vendors the experiment.
VITE_BASE_PATH=/e/packet-panic/

# Preview-only puzzle epoch while experiment.json launchDate is null. A launch
# build ignores this and uses the public manifest launchDate as its epoch.
VITE_PREVIEW_PUZZLE_EPOCH=2026-09-20

# Optional sponsor application URL. Falls back to the Cramzz sponsor policy.
VITE_SPONSOR_FORM_URL=

# Optional public PostHog project token and ingestion origin. Production sends
# only explicitly allowlisted anonymous events when both values are present.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Release/build orchestration only: exact 40-character source commit stamped
# into dist/experiment.json. Leave unset for local previews.
EXPERIMENT_SOURCE_COMMIT=
