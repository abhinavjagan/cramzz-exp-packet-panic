{
  "name": "cramzz-exp-packet-panic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "manifest:verify": "node scripts/verify-built-manifest.mjs",
    "metadata:verify": "node scripts/verify-built-html.mjs",
    "release:verify": "node scripts/verify-release-config.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "audit": "node --import tsx scripts/audit-game.ts",
    "screenshots": "node scripts/capture-assets.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "check": "npm run secrets:scan && npm run typecheck && npm test && npm run build && npm run manifest:verify && npm run metadata:verify && npm run release:verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "jsdom": "^26.1.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "4.1.11"
  }
}
